# Gemini Developer API. Keep this secret on the server only.
GEMINI_API_KEY=

# Alternative: Gemini Enterprise Agent Platform / Vertex authentication.
ANTIGRAVITY_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Leave unset to use the SDK default. Do not guess model identifiers.
ANTIGRAVITY_MODEL=

HOST=0.0.0.0
PORT=3100
ENVIRONMENT=development
APP_API_TOKEN=
ALLOWED_ORIGINS=
MAX_REQUESTS_PER_15_MINUTES=60
MAX_CONCURRENT_STREAMS=10
STREAM_TIMEOUT_SECONDS=120
ANTIGRAVITY_APP_DATA_DIR=/app/runtime/antigravity
# Optional comma-separated absolute paths. The bundled programmer skill is used by default.
ANTIGRAVITY_SKILLS_PATHS=
AGENT_SYSTEM_INSTRUCTIONS=You are a professional software engineering assistant. Answer in the user's language.
