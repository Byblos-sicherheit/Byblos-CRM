# Öffentlicher DNS-Name ohne https:// und ohne Pfad
DOMAIN=ai.byblos-sicherheit.com

# E-Mail-Adresse für ACME-/Zertifikatshinweise
ACME_EMAIL=info@byblos-sicherheit.de

# Ziele der bereits laufenden Apps.
# "host.docker.internal" bedeutet: App läuft direkt auf demselben PC.
# Ports an die tatsächlichen Ports der Apps anpassen.
LEXAI_UPSTREAM=host.docker.internal:3000
CRM_UPSTREAM=host.docker.internal:3001
WKS_UPSTREAM=host.docker.internal:3002
FILES_UPSTREAM=host.docker.internal:8080
